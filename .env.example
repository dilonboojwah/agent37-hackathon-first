# Everything is optional. With nothing set, the app runs fully offline:
# file-backed store, in-process executor, offline rule compiler, recorded tool lookups.

# --- OpenAI (agent model, rule compiler, plain-model baseline) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Supabase (system of record instead of .data/state.json) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Agent37 (run each workflow in its own persistent sandbox) ---
AGENT37_API_KEY=
AGENT37_TEMPLATE=agent37-hermes
# local | agent37. "agent37" sends Run now to the workflow's sandbox via exec.
EXECUTOR=local
# Public URL of this app, reachable from Agent37 (InstaCloud deploy or a tunnel).
APP_URL=http://localhost:3737
# Shared secret the sandbox runner uses to post events back to /api/agent/*.
AGENT_INGEST_TOKEN=change-me

# --- monid.ai (merchant lookup tool). Requires the monid CLI with a key added. ---
MONID_ENABLED=false
MONID_SEARCH_ENDPOINT=

# --- Demo pacing: delay between activity-feed lines, in ms (0 for tests) ---
DEMO_PACE_MS=140
